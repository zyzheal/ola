{
  "$version": 3,
  "trustedCommands": {
    "patterns": [
      "find *",
      "grep *",
      "sed *",
      "git *",
      "npm *",
      "node *",
      "ls *",
      "cat *",
      "chmod *"
    ],
    "enabled": true
  },
  "tools": {
    "approvalMode": "auto-edit",
    "useRipgrep": false
  },
  "permissions": {
    "allow": ["Bash(cargo build *)", "Bash(npm run *)"]
  },
  "advanced": {
    "autoConfigureMemory": false,
    "runtimeOutputDir": ".ola"
  },
  "general": {
    "enableAutoUpdate": false
  },
  "ide": {
    "enabled": false
  }
}
