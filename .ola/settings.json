{
  "$version": 3,
  "trustedCommands": {
    "patterns": [
      "find *",
      "grep *",
      "sed *",
      "git *",
      "npm *",
      "node *",
      "ls *",
      "cat *",
      "chmod *"
    ],
    "enabled": true
  },
  "tools": {
    "approvalMode": "auto-edit",
    "useRipgrep": false
  },
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(npm run *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "sequential": false,
        "hooks": [
          {
            "type": "command",
            "command": ".ola/hooks/security-check.sh",
            "name": "security-check",
            "description": "安全检测 - 阻止危险命令",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "sequential": false,
        "hooks": [
          {
            "type": "command",
            "command": ".ola/hooks/tool-logger.sh",
            "name": "tool-logger",
            "description": "记录所有工具的执行情况",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "sequential": false,
        "hooks": [
          {
            "type": "command",
            "command": ".ola/hooks/session-init.sh",
            "name": "session-init",
            "description": "会话初始化，加载项目上下文",
            "timeout": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "sequential": false,
        "hooks": [
          {
            "type": "command",
            "command": ".ola/hooks/prompt-validator.sh",
            "name": "prompt-validator",
            "description": "验证用户提示，检测敏感信息",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "advanced": {
    "autoConfigureMemory": false,
    "runtimeOutputDir": ".ola"
  },
  "general": {
    "enableAutoUpdate": false
  },
  "ide": {
    "enabled": false
  }
}
