-    token_type: 'Bearer',
-    expiry_date: Date.now() + 3600000, // 1 hour from now
-    resource_url: 'https://api.example.com',
-    ...initialCredentials,
-  };
-
-  return {
-    setCredentials: vi.fn((creds: QwenCredentials) => {
-      credentials = { ...credentials, ...creds };
-    }),
-    getCredentials: vi.fn(() => credentials),
