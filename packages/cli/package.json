{
  "name": "@zyzheal/ola",
  "version": "0.14.3",
  "description": "AI Platform Code Assistant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyzheal/ola.git"
  },
  "type": "module",
  "main": "cli.js",
  "bin": {
    "ola": "cli.js"
  },
  "scripts": {
    "build": "node ../../scripts/build_package.js",
    "prepublishOnly": "mkdir -p ./bundled && cp -r ../../dist/bundled/* ./bundled/ && mkdir -p ./locales && cp ../../dist/locales/* ./locales/ && mkdir -p ./vendor && cp -r ../../dist/vendor/* ./vendor/ && cp ../../dist/cli.js ./cli.js && cp ../../dist/sandbox-macos-*.sb ./ && cp ../../LICENSE ./LICENSE && cp ../../README.md ./README.md",
    "start": "NODE_ENV=development node dist/index.js",
    "start:prod": "node dist/index.js",
    "debug": "NODE_ENV=development node --inspect-brk dist/index.js",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "check-i18n": "tsx ../../scripts/check-i18n.ts"
  },
  "files": [
    "bundled",
    "locales",
    "vendor",
    "cli.js",
    "LICENSE",
    "README.md",
    "sandbox-macos-*.sb"
  ],
  "config": {
    "sandboxImageUri": "ghcr.io/your-org/ola:0.14.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.14.1",
    "@google/genai": "1.30.0",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "ola-core": "^0.14.0",
    "ola-web-templates": "^0.14.0",
    "@types/update-notifier": "^6.0.8",
    "ansi-regex": "^6.2.2",
    "command-exists": "^1.2.9",
    "comment-json": "^4.2.5",
    "diff": "^7.0.0",
    "dotenv": "^17.1.0",
    "fzf": "^0.5.2",
    "glob": "^10.5.0",
    "highlight.js": "^11.11.1",
    "ink": "^6.2.3",
    "ink-gradient": "^3.0.0",
    "ink-link": "^4.1.0",
    "ink-spinner": "^5.0.0",
    "lowlight": "^3.3.0",
    "open": "^10.1.2",
    "p-limit": "^7.3.0",
    "prompts": "^2.4.2",
    "react": "^19.1.0",
    "read-package-up": "^11.0.0",
    "shell-quote": "^1.8.3",
    "simple-git": "^3.28.0",
    "string-width": "^7.1.0",
    "strip-ansi": "^7.1.0",
    "strip-json-comments": "^3.1.1",
    "undici": "^6.22.0",
    "update-notifier": "^7.3.1",
    "wrap-ansi": "9.0.2",
    "yargs": "^17.7.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/runtime": "^7.27.6",
    "@google/gemini-cli-test-utils": "file:../test-utils",
    "ola-test-utils": "file:../test-utils",
    "@testing-library/react": "^16.3.0",
    "@types/archiver": "^6.0.3",
    "@types/command-exists": "^1.2.3",
    "@types/diff": "^7.0.2",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^20.11.24",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/semver": "^7.7.0",
    "@types/shell-quote": "^1.7.5",
    "@types/yargs": "^17.0.32",
    "archiver": "^7.0.1",
    "ink-testing-library": "^4.0.0",
    "jsdom": "^26.1.0",
    "pretty-format": "^30.0.2",
    "react-dom": "^19.1.0",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1"
  },
  "optionalDependencies": {
    "@teddyzhu/clipboard": "^0.0.5",
    "@teddyzhu/clipboard-darwin-arm64": "0.0.5",
    "@teddyzhu/clipboard-darwin-x64": "0.0.5",
    "@teddyzhu/clipboard-linux-arm64-gnu": "0.0.5",
    "@teddyzhu/clipboard-linux-x64-gnu": "0.0.5",
    "@teddyzhu/clipboard-win32-arm64-msvc": "0.0.5",
    "@teddyzhu/clipboard-win32-x64-msvc": "0.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
